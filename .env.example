# Shared secret — ten sam co VPS_WORKER_TOKEN w marketing-runner na Vercelu
VPS_WORKER_TOKEN=zmien-na-losowy-ciag-znakow

# Ścieżki na VPS
CLIENTS_DIR=/home/deploy/clients
SCRIPTS_DIR=/home/deploy/scripts
DATABASE_PATH=/home/deploy/worker.db

# Port uvicorn (słucha tylko na 127.0.0.1 — Nginx terminuje TLS)
PORT=8001
